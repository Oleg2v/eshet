{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eshet",
  "account_id": "be9447e281c6e9198712ade2d0241029",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "eshet.kikkey.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "eshet" }],
  "d1_databases": [
    {
      "binding": "LEADS_DB",
      "database_name": "eshet-concept-leads",
      "database_id": "b24c5c70-ea8c-46da-81e9-d7947fd05aff",
      "migrations_dir": "migrations",
    },
  ],
}
