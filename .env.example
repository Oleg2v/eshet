# Copy to .env.local for local use. Never commit populated credentials.
# Without provider keys, every public tool runs in clearly marked demo mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Set a unique private password of at least 12 characters to enable /he/admin.
# No password is supplied in the source and no default password exists.
ADMIN_PASSWORD=
# Optional separate signing secret; otherwise sessions derive from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# HTTPS endpoint receiving a visitor-approved structured brief after consent.
# Without it, submissions are stored locally and explicitly marked as demo-only.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional international digits only, with no spaces. Must be the verified business number.
# Without a valid confirmed number, WhatsApp opens a recipient chooser with the brief.
WHATSAPP_NUMBER=
# Optional persistent path for a self-hosted demo. Serverless defaults to ephemeral /tmp.
LEAD_STORE_DIR=
